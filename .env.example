# TrueTest credential environment example
#
# Launcher scripts deliberately do not source .env and do not select live mode.
# If you choose to load this file in your shell, keep it untracked and supply
# only the credentials for the attended engine_live ritual in docs/governance/01-prod.md.

TRUETEST_BINANCE_API_KEY=
TRUETEST_BINANCE_API_SECRET=

TRUETEST_BITGET_API_KEY=
TRUETEST_BITGET_API_SECRET=
TRUETEST_BITGET_API_PASSPHRASE=

TRUETEST_BITUNIX_API_KEY=
TRUETEST_BITUNIX_API_SECRET=

# Convenience wrappers accept --skip-build as an argument. They do not read
# TT_TASK, TT_PRESET, TT_MODE, provider, symbol, or build settings from .env.
