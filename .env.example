#!/usr/bin/env bash
# Launch Script Configuration
# Copy to .env and customize for your workflow
#
# Task-based presets (dev/bench/test/live) auto-configure common options
# Override individual settings below as needed

# ============================================================================
# TASK PRESETS (choose one or customize)
# ============================================================================
# dev   = Quick iteration (ImGui Desk, shadow mode, minimal build)
# bench = Performance testing (backtest, metrics, no UI)
# test  = Unit tests only (no engine, just truetest_tests)
# live  = Live provider connection (real Binance/Bitget/BitUNIX data)
#
TT_TASK=dev

# ============================================================================
# BUILD CONFIGURATION
# ============================================================================
# CMake preset: linux-dev, linux-tests, linux-bench, linux-release
# Default: auto-selected based on TT_TASK
TT_PRESET=

# Custom build directory (overrides CMake preset tree)
# Default: out/build/<preset>
TT_BUILD_DIR=

# Parallel build jobs (default: CPU core count)
TT_BUILD_JOBS=

# Build targets (advanced; normally auto-selected by script)
TT_BUILD_TARGETS=

# Skip rebuild if binary exists? (useful for rapid iteration)
TT_SKIP_BUILD=false

# ============================================================================
# DESK UI (ImGui) Configuration
# ============================================================================
# Enable ImGui Desk UI (default: true for dev/bench, false for test/live)
DESK_ENABLED=true

# Debug UI mode: show wireframes, performance stats, layout info
DESK_DEBUG_UI=false

# Layout preset file (relative to project root or absolute path)
# Example: src/ui/layouts/mobile.h, src/ui/layouts/desktop.h
DESK_LAYOUT=

# Auto-reload desk on file changes? (development only)
DESK_HOT_RELOAD=false

# ============================================================================
# MARKET DATA & PROVIDER
# ============================================================================
# Default provider: binance-futures, bitget, bitunix
# Default: binance-futures for dev, bitget for bench
TT_PROVIDER=

# Trading symbol (default: btcusdt)
TT_SYMBOL=btcusdt

# Stream type: trade, kline (default: trade)
TT_STREAM=trade

# Depth stream: depth5, depth10, depth20, or empty to disable
# Note: depth5 enables combined event-stream path for snapshots
TT_DEPTH_STREAM=depth5

# ============================================================================
# ENGINE & TRADING MODE
# ============================================================================
# Mode: shadow (paper trading), live (real trading), backtest
# Default: shadow for dev/bench/test, live for live task
TT_MODE=shadow

# Risk limit for orderflow (footprint) analysis
# Disabled by default; uncomment to enable orderflow/footprint panel
# TT_FOOTPRINT_TICK_SIZE=10

# ============================================================================
# DATA & LOGGING
# ============================================================================
# Log level: trace, debug, info, warn, error
TT_LOG_LEVEL=

# Cache market data? (useful for offline testing)
TT_USE_CACHE=false

# Snapshot mode: use cached/mocked data instead of live feeds
# (useful for UI development without network)
TT_SNAPSHOT_MODE=false

# ============================================================================
# DEVELOPMENT & DEBUGGING
# ============================================================================
# Enable native CPU optimizations (DANGEROUS; breaks reproducibility)
TT_ENABLE_NATIVE_OPT=false

# Enable debug symbols and asserts (slower, more diagnostic info)
TT_ENABLE_DEBUG=false

# Enable performance benchmarks (compiles benchmark utilities)
TT_ENABLE_BENCHMARKS=false

# Verbose output from build system
TT_VERBOSE_BUILD=false

# ============================================================================
# ADVANCED: Port & Networking
# ============================================================================
# WebSocket server port for desk UI (if applicable)
# TT_WS_PORT=8080

# API server port (if applicable)
# TT_API_PORT=3000

# ============================================================================
# NOTES:
# - Copy this file to .env and customize
# - .env is gitignored; each developer has their own
# - Environment variables override this file
# - Examples:
#     TT_TASK=bench TT_SYMBOL=ethusdt ./launch-bench.sh
#     TT_PROVIDER=bitget ./launch-default.sh
#     ./launch-desk.sh --desk-debug-ui  (CLI flags override env)
