{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-ninja",
      "displayName": "Windows (Ninja)",
      "description": "Ninja generator — requires Ninja on PATH",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-vs-2022",
      "displayName": "Windows (Visual Studio 2022)",
      "description": "MSBuild via Visual Studio 17 2022",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      }
    },
    {
      "name": "linux-default",
      "displayName": "Linux (Unix Makefiles)",
      "description": "Basic Linux debug build",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-tests",
      "displayName": "Linux + Tests (Debug)",
      "description": "Common developer setup with full unit tests",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-binance-questdb",
      "displayName": "Linux + Binance + QuestDB + Tests",
      "description": "Featured combination for Binance futures + QuestDB persistence + tests",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_BINANCE": "ON",
        "ENABLE_QUESTDB": "ON",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-bitget",
      "displayName": "Linux + Bitget + Tests",
      "description": "Bitget UTA futures provider + unit tests",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_BITGET": "ON",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-providers-questdb",
      "displayName": "Linux + Binance + Bitget + QuestDB + Tests",
      "description": "Both exchange providers + QuestDB + tests (phase0 / multi-venue dev)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_BINANCE": "ON",
        "ENABLE_BITGET": "ON",
        "ENABLE_QUESTDB": "ON",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-web",
      "displayName": "Linux + Web UI + Tests",
      "description": "Embedded web server (civetweb) + tests. Requires npm for web_assets target.",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_WEB": "ON",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux + ASAN + Tests (Debug)",
      "description": "AddressSanitizer + UBSAN (mutually exclusive with TSAN)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON",
        "ENABLE_ASAN": "ON",
        "ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "linux-tsan",
      "displayName": "Linux + TSAN + Tests (Debug)",
      "description": "ThreadSanitizer (cannot be combined with ASAN/UBSAN)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON",
        "ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "linux-benchmarks",
      "displayName": "Linux + Benchmarks + Debug + Tests",
      "description": "Google Benchmark + instrumentation + tests",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_DEBUG": "ON",
        "ENABLE_BENCHMARKS": "ON",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-release-native",
      "displayName": "Linux Release + Native Opt",
      "description": "Release with -march=native on all three engines (ENABLE_NATIVE_OPT)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_NATIVE_OPT": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux-default", "configurePreset": "linux-default" },
    { "name": "linux-tests", "configurePreset": "linux-tests" },
    { "name": "linux-binance-questdb", "configurePreset": "linux-binance-questdb" },
    { "name": "linux-bitget", "configurePreset": "linux-bitget" },
    { "name": "linux-providers-questdb", "configurePreset": "linux-providers-questdb" },
    { "name": "linux-web", "configurePreset": "linux-web" },
    { "name": "linux-asan", "configurePreset": "linux-asan" },
    { "name": "linux-tsan", "configurePreset": "linux-tsan" },
    { "name": "linux-benchmarks", "configurePreset": "linux-benchmarks" },
    { "name": "linux-release-native", "configurePreset": "linux-release-native" }
  ]
}
