{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-ninja",
      "displayName": "Windows (Ninja)",
      "description": "Ninja generator — requires Ninja on PATH",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-vs-2022",
      "displayName": "Windows (Visual Studio 2022)",
      "description": "MSBuild via Visual Studio 17 2022",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      }
    },
    {
      "name": "linux-default",
      "displayName": "Linux (Unix Makefiles)",
      "description": "Basic Linux debug build",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },

    {
      "name": "linux-tests",
      "displayName": "Linux + Tests (Debug)",
      "description": "Common developer setup with full unit tests",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-research-only",
      "displayName": "Linux Research-only Release + Tests",
      "description": "Binary research distribution without an engine_live target or artifact",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTS": "ON",
        "ENABLE_BINANCE": "OFF",
        "ENABLE_BITGET": "OFF",
        "ENABLE_LTO": "OFF",
        "ENABLE_NATIVE_OPT": "OFF",
        "TRUETEST_RESEARCH_ONLY": "ON"
      }
    },
    {
      "name": "linux-deterministic",
      "displayName": "Linux Deterministic Research Release + Tests",
      "description": "Portable R6 run/replay profile with fixed floating-point policy and disconnected dependency updates",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS": "",
        "CMAKE_C_FLAGS_RELEASE": "-O3 -DNDEBUG",
        "CMAKE_CXX_FLAGS": "",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG",
        "CMAKE_EXE_LINKER_FLAGS": "",
        "CMAKE_EXE_LINKER_FLAGS_RELEASE": "",
        "CMAKE_SHARED_LINKER_FLAGS": "",
        "CMAKE_SHARED_LINKER_FLAGS_RELEASE": "",
        "CMAKE_MODULE_LINKER_FLAGS": "",
        "CMAKE_MODULE_LINKER_FLAGS_RELEASE": "",
        "CMAKE_STATIC_LINKER_FLAGS": "",
        "CMAKE_STATIC_LINKER_FLAGS_RELEASE": "",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTS": "ON",
        "BUILD_SHARED_LIB": "OFF",
        "ENABLE_ASAN": "OFF",
        "ENABLE_BENCHMARKS": "OFF",
        "ENABLE_BINANCE": "OFF",
        "ENABLE_BITGET": "OFF",
        "ENABLE_BITUNIX": "OFF",
        "ENABLE_DEBUG": "OFF",
        "ENABLE_IMGUI": "OFF",
        "ENABLE_LIVE_DATA": "OFF",
        "ENABLE_LTO": "OFF",
        "ENABLE_NATIVE_OPT": "OFF",
        "ENABLE_QUESTDB": "OFF",
        "ENABLE_TSAN": "OFF",
        "ENABLE_UBSAN": "OFF",
        "ENABLE_WEB": "OFF",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF",
        "CMAKE_UNITY_BUILD": "OFF",
        "FETCHCONTENT_FULLY_DISCONNECTED": "OFF",
        "FETCHCONTENT_UPDATES_DISCONNECTED": "ON",
        "TRUETEST_RESEARCH_ONLY": "ON",
        "TRUETEST_DETERMINISTIC_BUILD": "ON",
        "TRUETEST_BUILD_PROFILE": "linux-deterministic-v1"
      }
    },
    {
      "name": "linux-binance-questdb",
      "displayName": "Linux + Binance + QuestDB + Tests",
      "description": "Featured combination for Binance futures + QuestDB persistence + tests",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_BINANCE": "ON",
        "ENABLE_QUESTDB": "ON",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-bitget",
      "displayName": "Linux + Bitget + Tests",
      "description": "Bitget UTA futures provider + unit tests",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_BITGET": "ON",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-bitunix",
      "displayName": "Linux + Bitunix + Tests",
      "description": "Bitunix futures MD/shadow provider + unit tests",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_BITUNIX": "ON",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-venues",
      "displayName": "Linux + Binance + Bitget + Bitunix + Tests",
      "description": "Product venues (Binance, Bitget, Bitunix) + tests",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_BINANCE": "ON",
        "ENABLE_BITGET": "ON",
        "ENABLE_BITUNIX": "ON",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-dev",
      "displayName": "Linux daily dev (venues + ImGui + tests)",
      "description": "Single warm tree for desk/shadow work. Prefer over ad-hoc build-dev/ to avoid duplicate multi-GB trees.",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON",
        "ENABLE_IMGUI": "ON",
        "ENABLE_BINANCE": "ON",
        "ENABLE_BITGET": "ON",
        "ENABLE_BITUNIX": "ON"
      }
    },
    {
      "name": "linux-providers-questdb",
      "displayName": "Linux + All Venues + QuestDB + Tests",
      "description": "Binance + Bitget + Bitunix + QuestDB + tests (ops-style full provider matrix)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_BINANCE": "ON",
        "ENABLE_BITGET": "ON",
        "ENABLE_BITUNIX": "ON",
        "ENABLE_QUESTDB": "ON",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-web",
      "displayName": "Linux + Web UI + Tests",
      "description": "Embedded web server (civetweb) + tests. Requires npm for web_assets target.",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_WEB": "ON",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux + ASAN + Tests (Debug)",
      "description": "AddressSanitizer + UBSAN (mutually exclusive with TSAN)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON",
        "ENABLE_ASAN": "ON",
        "ENABLE_UBSAN": "ON",
        "ENABLE_BINANCE": "ON"
      }
    },
    {
      "name": "linux-ubsan",
      "displayName": "Linux + UBSAN + Tests (Debug)",
      "description": "UndefinedBehaviorSanitizer (standalone) + tests",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON",
        "ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "linux-shared-lib",
      "displayName": "Linux + Shared C API Library + Tests",
      "description": "Build libtruetest shared library (C API) with test matrix",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_SHARED_LIB": "ON",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-tsan",
      "displayName": "Linux + TSAN + Tests (Debug)",
      "description": "ThreadSanitizer (cannot be combined with ASAN/UBSAN)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON",
        "ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "linux-benchmarks",
      "displayName": "Linux + Benchmarks + Debug + Tests",
      "description": "Google Benchmark + instrumentation + tests",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_DEBUG": "ON",
        "ENABLE_BENCHMARKS": "ON",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-release-native",
      "displayName": "Linux Release + Native Opt (all engines)",
      "description": "Release with -march=native etc. (affects all three engines when ENABLE_NATIVE_OPT=ON)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_NATIVE_OPT": "ON"
      }
    },
    {
      "name": "linux-release-low-memory",
      "displayName": "Linux Release + Tests (portable, no LTO)",
      "description": "Portable Release validation with tests and LTO disabled to reduce peak memory",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "ON",
        "ENABLE_LTO": "OFF",
        "ENABLE_NATIVE_OPT": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-ninja", "configurePreset": "windows-ninja", "jobs": 1 },
    { "name": "windows-vs-2022", "configurePreset": "windows-vs-2022", "jobs": 1 },
    { "name": "linux-default", "configurePreset": "linux-default", "jobs": 1 },
    { "name": "linux-tests", "configurePreset": "linux-tests", "jobs": 1 },
    { "name": "linux-research-only", "configurePreset": "linux-research-only", "jobs": 1 },
    { "name": "linux-deterministic", "configurePreset": "linux-deterministic", "jobs": 1 },
    { "name": "linux-binance-questdb", "configurePreset": "linux-binance-questdb", "jobs": 1 },
    { "name": "linux-bitget", "configurePreset": "linux-bitget", "jobs": 1 },
    { "name": "linux-bitunix", "configurePreset": "linux-bitunix", "jobs": 1 },
    { "name": "linux-venues", "configurePreset": "linux-venues", "jobs": 1 },
    { "name": "linux-dev", "configurePreset": "linux-dev", "jobs": 1 },
    { "name": "linux-providers-questdb", "configurePreset": "linux-providers-questdb", "jobs": 1 },
    { "name": "linux-web", "configurePreset": "linux-web", "jobs": 1 },
    { "name": "linux-asan", "configurePreset": "linux-asan", "jobs": 1 },
    { "name": "linux-ubsan", "configurePreset": "linux-ubsan", "jobs": 1 },
    { "name": "linux-shared-lib", "configurePreset": "linux-shared-lib", "jobs": 1 },
    { "name": "linux-tsan", "configurePreset": "linux-tsan", "jobs": 1 },
    { "name": "linux-benchmarks", "configurePreset": "linux-benchmarks", "jobs": 1 },
    { "name": "linux-release-native", "configurePreset": "linux-release-native", "jobs": 1 },
    { "name": "linux-release-low-memory", "configurePreset": "linux-release-low-memory", "jobs": 1 }
  ],
  "testPresets": [
    {
      "name": "linux-tests",
      "configurePreset": "linux-tests",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 1, "noTestsAction": "error" }
    },
    {
      "name": "linux-research-only",
      "configurePreset": "linux-research-only",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 1, "noTestsAction": "error" }
    },
    {
      "name": "linux-deterministic",
      "configurePreset": "linux-deterministic",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 1, "noTestsAction": "error" }
    },
    {
      "name": "linux-release-low-memory",
      "configurePreset": "linux-release-low-memory",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 1, "noTestsAction": "error" }
    }
  ]
}
